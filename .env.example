# PowerLift-AI-X Environment Configuration

# Application
APP_NAME=PowerLift-AI-X
APP_VERSION=0.1.0
ENVIRONMENT=development

# API
POWERLIFT_API_HOST=127.0.0.1
POWERLIFT_API_PORT=8000

# Database
POWERLIFT_DATABASE_URL=

# Data directories
POWERLIFT_RAW_DATA_DIR=data/raw
POWERLIFT_EXTRACTED_DATA_DIR=data/extracted
POWERLIFT_CLEANED_DATA_DIR=data/cleaned
POWERLIFT_FINAL_DATA_DIR=data/final

# Model directory
POWERLIFT_MODEL_DIR=models

# Logging
LOG_LEVEL=INFO